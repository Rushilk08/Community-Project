# WorkLink Backend Environment Configuration
# Duplicate this file as .env and fill in your Supabase credentials

# Flask Server Port
PORT=5000
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Supabase Credentials (obtain from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-secret-key...

# Matching & Dispatch Parameters
DISPATCH_RADIUS_KM=10
OFFER_EXPIRY_MINUTES=5
LOCATION_STALE_HOURS=24
